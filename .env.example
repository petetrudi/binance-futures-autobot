# Server & Trading Mode
PORT=4000
TRADING_MODE=PAPER

# Binance Futures API Credentials (required only for TESTNET or LIVE modes)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional custom overrides (leave empty for default testnet/live URLs)
BINANCE_FAPI_BASE_URL=
BINANCE_FWS_BASE_URL=
LIVE_TRADING_CONFIRMED=false

# Gemini AI News Sentiment Engine (uses current Interactions API with gemini-3.8-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Extra News & Telegram Alerts
CRYPTOPANIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
